# Copy to `.env` and adjust values for local runs.
# Docker Compose overrides some container-only paths/URLs internally, but keeps the same variable names.

# -----------------------------------------------------------------------------
# Shared runtime settings
# -----------------------------------------------------------------------------
LOG_LEVEL=info
REDIS_ADDR=127.0.0.1:6379

# -----------------------------------------------------------------------------
# bronivik_jr
# -----------------------------------------------------------------------------
BOT_TOKEN=
JR_DB_PATH=./bronivik_jr/data/bookings.db
JR_API_HTTP_PORT=8080
JR_API_GRPC_PORT=8081
JR_API_AUTH_ENABLED=true

# Credentials used by bronivik_crm to call the JR API
CRM_API_KEY=
CRM_API_EXTRA=

# Optional Google Sheets integration for bronivik_jr
GOOGLE_CREDENTIALS_FILE=./credentials/google-credentials.json
USERS_SPREADSHEET_ID=
BOOKINGS_SPREADSHEET_ID=

# Optional path overrides
# CONFIG_PATH=bronivik_jr/configs/config.yaml
# ITEMS_PATH=bronivik_jr/configs/items.yaml

# -----------------------------------------------------------------------------
# bronivik_crm
# -----------------------------------------------------------------------------
CRM_BOT_TOKEN=
CRM_DB_PATH=./bronivik_crm/data/bronivik_crm.db
JR_API_BASE_URL=http://localhost:8080
CRM_HEALTH_PORT=8090
CRM_REDIS_DB=1

# Optional path override
# CRM_CONFIG_PATH=bronivik_crm/configs/config.yaml
